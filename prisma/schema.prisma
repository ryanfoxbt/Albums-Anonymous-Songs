// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id         String @id @default(cuid())
  name       String
  slug       String @unique
  bio        String?
  songs      Song[] @relation("SongArtist")
  featuredOn Song[] @relation("SongFeaturedArtist")
}

model Genre {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  songs Song[]
}

model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  songs Song[]
}

model SocialLink {
  id        String   @id @default(cuid())
  name      String
  href      String
  createdAt DateTime @default(now())
}

// Singleton row (id always "default") holding site-wide branding, e.g.
// the logo used as MediaSession artwork on the car/lock-screen "Now
// Playing" display.
model SiteSetting {
  id                    String   @id @default("default")
  logoUrl               String?
  announcementText      String?
  announcementEnabled   Boolean  @default(false)
  announcementLinkUrl   String?
  announcementLinkText  String?
  announcementLinkStyle String   @default("link") // "link" | "button"
  announcementHideOnHome Boolean @default(false)

  // A/B test for the header's merch link text. Visitors are deterministically
  // bucketed into "a" or "b" from their aa_vid cookie (see
  // src/lib/merchVariant.ts) — no assignment is stored per-visitor.
  merchAbTestEnabled Boolean @default(true)
  merchVariantAText  String  @default("Your wife will hate it")
  merchVariantBText  String  @default("Mom would be so disappointed")

  // When true (default) the header's merch link stays hidden until the
  // visitor clears the engagement bar in src/lib/merchEngagement.ts.
  // Untick it to show the link to everyone.
  merchLinkGateEnabled Boolean @default(true)

  updatedAt             DateTime @updatedAt
}

model Song {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  audioUrl        String
  downloadUrl     String
  durationSeconds Int?
  bpm             Int?
  coverImageUrl   String?
  hidden          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  podcastEpisodeTitle String?
  podcastEpisodeUrl   String?
  firstHeardOnEpisode Int?
  lyrics              String?

  artist   Artist @relation("SongArtist", fields: [artistId], references: [id])
  artistId String

  featuredArtist   Artist? @relation("SongFeaturedArtist", fields: [featuredArtistId], references: [id])
  featuredArtistId String?

  genre   Genre  @relation(fields: [genreId], references: [id])
  genreId String

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  songPlays         SongPlayEvent[]
  podcastLinkClicks PodcastLinkClick[]
  downloadLinks     SongDownloadLink[]

  @@index([artistId])
  @@index([featuredArtistId])
  @@index([genreId])
  @@index([categoryId])
}

model SongDownloadLink {
  id            String    @id @default(cuid())
  label         String?
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?
  downloadCount Int       @default(0)

  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId String

  @@index([songId])
}

model PressedRecord {
  id        String   @id @default(cuid())
  slug      String   @unique
  songIds   String[]
  editToken String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A recorded DJ performance. Not audio — `events` is the ordered list of
// control changes (see src/components/dj/mixTypes.ts) that the /mix/[slug]
// page replays live against the songs in `songIds`.
model DjMix {
  id         String   @id @default(cuid())
  slug       String   @unique
  songIds    String[]
  events     Json
  durationMs Int
  editToken  String
  /** Anonymous analytics id (aa_vid cookie) of whoever recorded it, if any. */
  visitorId  String?
  /** Times the /mix/[slug] page was opened. */
  viewCount  Int      @default(0)
  /** Times a viewer actually pressed play on the replay. */
  playCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
  @@index([visitorId])
}

// --- Analytics ---
// Identity is a long-lived `aa_vid` cookie (Visitor.id) plus a 30-min
// sliding `aa_sid` cookie (VisitSession.id), both minted in src/proxy.ts.
// All writes happen from route handlers, never from the proxy itself.

model Visitor {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  // First-touch attribution, captured once and never overwritten.
  firstUtmSource   String?
  firstUtmMedium   String?
  firstUtmCampaign String?
  firstUtmTerm     String?
  firstUtmContent  String?
  firstReferrer    String?
  firstLandingPath String?
  country          String?
  region           String?
  city             String?

  sessions               VisitSession[]
  songPlays              SongPlayEvent[]
  podcastLinkClicks      PodcastLinkClick[]
  announcementLinkClicks AnnouncementLinkClick[]
  merchLinkClicks        MerchLinkClick[]
  subscriber             Subscriber?

  @@index([createdAt])
}

model VisitSession {
  id             String   @id @default(cuid())
  visitor        Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  visitorId      String
  startedAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  isReturning    Boolean  @default(false)

  // This session's own attribution (may differ from the visitor's
  // first-touch values if they arrive again via a different campaign).
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  referrer    String?
  landingPath String?
  country     String?
  region      String?
  city        String?
  deviceType  String?
  browser     String?
  os          String?
  entryChoice String?

  pageViews              PageView[]
  songPlays              SongPlayEvent[]
  podcastLinkClicks      PodcastLinkClick[]
  announcementLinkClicks AnnouncementLinkClick[]
  merchLinkClicks        MerchLinkClick[]

  @@index([visitorId])
  @@index([startedAt])
  @@index([utmSource, utmMedium, utmCampaign])
}

model PageView {
  id         String       @id @default(cuid())
  session    VisitSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  path       String
  visitedAt  DateTime     @default(now())
  durationMs Int?

  @@index([sessionId])
  @@index([path])
  @@index([visitedAt])
}

model SongPlayEvent {
  id              String       @id @default(cuid())
  song            Song         @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId          String
  visitor         Visitor      @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  visitorId       String
  session         VisitSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId       String
  path            String
  playedAt        DateTime     @default(now())
  listenedSeconds Int?
  completed       Boolean      @default(false)

  @@index([songId])
  @@index([visitorId])
  @@index([playedAt])
}

// A click on the "First heard on" podcast-episode link (usually YouTube)
// shown in the now-playing bar for the song currently loaded.
model PodcastLinkClick {
  id        String       @id @default(cuid())
  song      Song         @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId    String
  visitor   Visitor      @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  visitorId String
  session   VisitSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  path      String
  url       String
  clickedAt DateTime     @default(now())

  @@index([songId])
  @@index([visitorId])
  @@index([clickedAt])
}

// A click on the announcement banner's link, wherever it was shown at
// the time — the message/URL are snapshotted since the banner content
// can change after the click happened.
model AnnouncementLinkClick {
  id        String       @id @default(cuid())
  visitor   Visitor      @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  visitorId String
  session   VisitSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  path      String
  url       String
  text      String
  clickedAt DateTime     @default(now())

  @@index([visitorId])
  @@index([clickedAt])
}

// A click on the header's merch link, tagged with which A/B variant text
// the visitor saw (see src/lib/merchVariant.ts).
model MerchLinkClick {
  id        String       @id @default(cuid())
  visitor   Visitor      @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  visitorId String
  session   VisitSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  path      String
  variant   String
  text      String
  clickedAt DateTime     @default(now())

  @@index([visitorId])
  @@index([variant])
  @@index([clickedAt])
}

// Local join key so admin analytics can tie a visitor's journey to an
// email address. Resend (see src/lib/resend.ts) stays the actual
// mailing-list source of truth — this table never sends mail.
model Subscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  visitor      Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  visitorId    String?  @unique
  subscribedAt DateTime @default(now())
}

model UtmLink {
  id              String   @id @default(cuid())
  label           String
  destinationPath String
  utmSource       String
  utmMedium       String
  utmCampaign     String
  utmTerm         String?
  utmContent      String?
  createdAt       DateTime @default(now())
}

// Admin edits to a parody-artist trading card, keyed by artist slug. The
// baked-in defaults live in src/lib/artistCards.ts; `data` is a partial
// overlay of the editable fields and `imageUrl` (a blob URL) overrides the
// static /cards art when set. See src/lib/artistCardStore.ts.
model ArtistCardOverride {
  slug      String   @id
  data      Json     @default("{}")
  imageUrl  String?
  updatedAt DateTime @updatedAt
}
