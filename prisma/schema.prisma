// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  bio   String?
  songs Song[]
}

model Genre {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  songs Song[]
}

model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  songs Song[]
}

model Song {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  audioUrl        String
  downloadUrl     String
  durationSeconds Int?
  coverImageUrl   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  podcastEpisodeTitle String?
  podcastEpisodeUrl   String?
  firstHeardOnEpisode Int?

  artist   Artist @relation(fields: [artistId], references: [id])
  artistId String

  genre   Genre  @relation(fields: [genreId], references: [id])
  genreId String

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  @@index([artistId])
  @@index([genreId])
  @@index([categoryId])
}

model PressedRecord {
  id        String   @id @default(cuid())
  slug      String   @unique
  songIds   String[]
  editToken String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
