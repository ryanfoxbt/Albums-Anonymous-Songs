# Copy this file to .env and fill in real values. Never commit .env.

# Vercel Postgres connection string.
# Vercel dashboard -> your project -> Storage -> your Postgres DB -> ".env.local" tab,
# or run `vercel env pull` once the project is linked.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Direct (non-pooled) connection, used only by the Prisma CLI for
# `db push`/`migrate` — pgbouncer's transaction pooler can't grant the
# advisory lock the schema engine needs. Use the Supabase "Session pooler"
# or "Direct connection" string here, not the transaction pooler.
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Clerk keys. Create a free app at https://dashboard.clerk.com, then
# Clerk dashboard -> your app -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx"
